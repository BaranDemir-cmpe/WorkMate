<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Activity.ChatActivity">
    
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/orange"
        android:layout_marginTop="40dp"
        android:padding="10dp">
        
        <TextView
            android:id="@+id/receiver_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="15dp"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/profile_picture_image"/>

        <TextView
            android:id="@+id/receiver_Surname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Surname"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="7dp"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/receiver_name"/>


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profile_picture_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:srcCompat="@drawable/profile"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:elevation="3dp"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp"/>



    </RelativeLayout>
        
    
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_messages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottom_layout"/>

    <RelativeLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:padding="8dp">
        
        <EditText
            android:id="@+id/editText_Message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mesaj Girin"
            android:layout_centerInParent="true"
            android:layout_margin="10dp"
            android:padding="10dp"
            android:background="@drawable/edittext_bg"
            android:layout_toLeftOf="@id/message_sent_btn"/>

        <ImageButton
            android:id="@+id/message_sent_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/send_icon"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/orange"
            android:padding="8dp"
            android:layout_marginStart="10dp"/>

        
    </RelativeLayout>

    

</RelativeLayout>