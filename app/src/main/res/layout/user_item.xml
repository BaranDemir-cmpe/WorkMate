<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/orangeMid"
    app:strokeWidth="3dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profile_image_user_item"
            android:layout_width="75dp"
            android:layout_height="75dp"
            app:srcCompat="@drawable/profile"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            android:scaleType="centerCrop"
            android:elevation="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"/>


        <TextView
            android:id="@+id/text_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Name"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/profile_image_user_item"
            app:layout_constraintTop_toTopOf="@id/profile_image_user_item" />

        <TextView
            android:id="@+id/text_user_surname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Surname"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/text_user_name"
            app:layout_constraintStart_toEndOf="@+id/text_user_name"
            app:layout_constraintTop_toTopOf="@+id/text_user_name" />


        <ImageView
            android:id="@+id/applicant_message_icon"
            android:layout_width="41dp"
            android:layout_height="38dp"
            android:layout_marginStart="30dp"
            app:layout_constraintEnd_toStartOf="@id/applicant_cv_icon"
            app:layout_constraintTop_toTopOf="@+id/text_user_surname"
            app:srcCompat="@drawable/message_icon" />

        <ImageView
            android:id="@+id/applicant_cv_icon"
            android:layout_width="41dp"
            android:layout_height="38dp"
            app:layout_constraintTop_toTopOf="@id/applicant_message_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/resume_icon" />


        <ImageView
            android:id="@+id/imageView19"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_image_user_item"
            app:srcCompat="@drawable/location"
            app:tint="@color/orange" />

        <TextView
            android:id="@+id/text_user_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konum"
            android:textColor="@color/black"
            android:layout_marginStart="16dp"
            android:textSize="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/imageView19"
            app:layout_constraintStart_toEndOf="@+id/imageView19"
            app:layout_constraintTop_toTopOf="@+id/imageView19"/>

        <TextView
            android:id="@+id/text_user_profession"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Mesleği"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView19"
            android:gravity="center"

            android:background="@drawable/grey_bg" />

        <LinearLayout
            android:id="@+id/linear_layout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_user_profession"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"

            >


            <TextView
                android:id="@+id/text_user_educationStatus"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:text="Eğitim Durumu"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:textAlignment="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="0.5"
                android:background="@drawable/grey_bg" />

            <TextView
                android:id="@+id/text_user_gender"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:text="Cinsiyet"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_weight="0.5"
                android:background="@drawable/grey_bg" />

        </LinearLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>


</com.google.android.material.card.MaterialCardView>